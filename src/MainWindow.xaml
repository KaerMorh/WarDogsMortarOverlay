<Window x:Class="WarDogs.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="WARDOGS · 战术地图" Width="1280" Height="820" MinWidth="1000" MinHeight="660" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Grid Margin="24" Background="{StaticResource Bg}">
  <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="WARDOGS" FontSize="12" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="火力工作台" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button x:Name="MapNav" Content="战术地图" Style="{StaticResource Primary}" Click="ShowMapPage" Padding="20,10"/><Button x:Name="SettingsNav" Content="设置" Click="ShowSettingsPage" Padding="20,10"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="BuildLabel" Text="离线可用" Margin="0,0,18,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11"/><Button Content="返回 HUD" Click="BackToHud"/><Button Content="退出" Click="QuitClick"/></StackPanel>
  </Grid>
  <Grid x:Name="MapPage" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition Width="282"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" CornerRadius="10" BorderBrush="#303B4D" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/><RowDefinition Height="36"/></Grid.RowDefinitions>
    <Grid Margin="16,10"><TextBlock x:Name="MapTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="MapOriginBtn" Content="放置炮位" Click="MapOriginClick"/><Button x:Name="MapTargetBtn" Content="选定目标" Style="{StaticResource Primary}" Click="MapTargetClick"/><Button Content="定位两点" Click="FitClick"/></StackPanel></Grid>
    <wv:WebView2 x:Name="MapView" Grid.Row="1" DefaultBackgroundColor="#10141C"/>
    <TextBlock Grid.Row="2" x:Name="MapHint" Text="拖动平移 · 滚轮缩放 · 点击设置目标 · Tower 标记可直接选择" VerticalAlignment="Center" Margin="16,0" FontSize="11" Foreground="{StaticResource Muted}"/>
   </Grid></Border>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="射击参数" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,14"/>
    <Border Background="#1A2434" BorderBrush="#354B69" BorderThickness="1" CornerRadius="9" Padding="18"><StackPanel>
     <TextBlock x:Name="ArcLabel" Text="迫击炮密位 / MIL" Foreground="{StaticResource Muted}" FontSize="11"/>
     <TextBlock x:Name="Elevation" Text="—" FontSize="43" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,2,0,14"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="距离 m" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="Distance" Text="—" FontSize="26"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="方位 °" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="Azimuth" Text="—" FontSize="26"/></StackPanel></Grid>
     <TextBlock x:Name="RangeStatus" Text="等待炮位与目标" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0"/>
    </StackPanel></Border>
    <TextBlock Text="当前配置" FontSize="13" FontWeight="SemiBold" Margin="0,22,0,10"/>
    <WrapPanel><Button x:Name="WeaponButton" Tag="weapon" Click="ActionClick"/><Button x:Name="MapSwitchButton" Tag="map" Click="ActionClick"/><Button x:Name="ModeButton" Tag="mode" Click="ActionClick"/></WrapPanel>
    <TextBlock x:Name="StateLabel" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,6,0,18"/>
    <Border BorderBrush="#303B4D" BorderThickness="0,1,0,0" Padding="0,16,0,0"><StackPanel>
     <TextBlock Text="炮位" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="OriginLabel" FontSize="16" Margin="0,4,0,12"/>
     <TextBlock Text="目标" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="TargetLabel" FontSize="16" Margin="0,4,0,8"/>
     <TextBlock x:Name="SourceLabel" Foreground="{StaticResource Muted}" FontSize="10"/>
     <UniformGrid Columns="2" Margin="0,14,0,0"><Button Content="读取炮位" Tag="origin" Click="ActionClick"/><Button Content="读取目标" Tag="target" Style="{StaticResource Primary}" Click="ActionClick"/></UniformGrid>
     <Button Content="停止 / 恢复接收" Tag="pause" Click="ActionClick"/>
    </StackPanel></Border>
    <StackPanel x:Name="PendingPanel" Visibility="Collapsed"><TextBlock Text="收到新坐标" Foreground="{StaticResource Accent}"/><WrapPanel><Button Content="采用" Tag="pending" Click="ActionClick"/><Button Content="忽略" Tag="discard" Click="ActionClick"/></WrapPanel></StackPanel>
    <Expander Header="手动输入"><StackPanel Margin="0,8"><TextBox x:Name="ManualInput" ToolTip="x12.11 y11.11"/><WrapPanel Margin="0,8,0,0"><Button Content="设为炮位" Click="ManualOrigin"/><Button Content="设为目标" Click="ManualTarget"/></WrapPanel></StackPanel></Expander>
    <TextBlock x:Name="NoticeList" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" LineHeight="18" Margin="0,16,0,0"/>
   </StackPanel></ScrollViewer>
  </Grid>
  <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,16,30,0"><TextBlock Text="应用设置" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="快捷键与 HUD 外观" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/><TextBlock Text="这里的设置与悬浮窗同步。&#10;&#10;也可以完全不打开地图，直接在 HUD 的“设置”中完成。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,22,0,0" LineHeight="23"/><Button Content="仅使用悬浮窗" Click="BackToHud" Margin="0,25,0,0"/></StackPanel>
   <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="26"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsHost" MaxWidth="640" HorizontalAlignment="Left"/></ScrollViewer></Border>
  </Grid>
  <TextBlock Grid.Row="2" Text="WARDOGS OVERLAY  0.6.1   ·   本地计算 / 默认射表   ·   关闭地图不退出 HUD" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Bottom"/>
 </Grid>
</Window>
